rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userHasCurrentAccess(userId) {
      return (
        get(/databases/$(database)/documents/users/$(userId)).data.subscriptionStatus == 'active'
        && (
          !get(/databases/$(database)/documents/users/$(userId)).data.keys().hasAny(['subscriptionExpiresAt'])
          || get(/databases/$(database)/documents/users/$(userId)).data.subscriptionExpiresAt > request.time
        )
      ) || (
        get(/databases/$(database)/documents/users/$(userId)).data.keys().hasAny(['freeAccessUntil'])
        && get(/databases/$(database)/documents/users/$(userId)).data.freeAccessUntil > request.time
      );
    }

    function hasCurrentAccess() {
      return userHasCurrentAccess(request.auth.uid);
    }

    function isActiveMember() {
      return isAdmin() || (
        signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isOnboarded == true
        && hasCurrentAccess()
      );
    }

    function isActiveUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.accountStatus == 'active'
        && get(/databases/$(database)/documents/users/$(userId)).data.isOnboarded == true
        && userHasCurrentAccess(userId);
    }

    // Private account source. Other members use publicProfiles/{uid}; they never
    // receive email, exact location, push tokens, lifecycle, points, or referral data.
    match /users/{userId} {
      function allowedProfileUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'location',
          'locationGeohash',
          'locationName',
          'profileSetupComplete',
          'hiddenReusePostIds',
          'postTemplates',
          'updatedAt'
        ])
        && (
          !request.resource.data.keys().hasAny(['profileSetupComplete'])
          || request.resource.data.profileSetupComplete != true
          || (
            request.resource.data.displayName is string
            && request.resource.data.displayName.size() >= 1
            && request.resource.data.bio is string
            && request.resource.data.bio.size() >= 20
            && request.resource.data.photoURL is string
            && request.resource.data.photoURL.matches('https://.*')
          )
        );
      }

      allow read: if isSelf(userId) || isAdmin();
      // Phone signup is created by completePhoneSignUp using the Admin SDK.
      // Disallowing client create also closes the enabled-email-provider bypass.
      allow create: if false;
      allow update: if isSelf(userId) && allowedProfileUpdate() || isAdmin();
      allow delete: if false;

      match /pointsHistory/{entryId} {
        allow read: if isSelf(userId) || isAdmin();
        allow write: if false;
      }

      match /favorites/{favoriteId} {
        allow read: if isSelf(userId) && isActiveMember();
        allow create: if isSelf(userId)
          && isActiveMember()
          && favoriteId != userId
          && isActiveUser(favoriteId)
          && request.resource.data.keys().hasOnly([
            'notifyOnPost',
            'createdAt'
          ])
          && request.resource.data.notifyOnPost is bool;
        allow update: if isSelf(userId)
          && isActiveMember()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'notifyOnPost'
          ])
          && request.resource.data.notifyOnPost is bool;
        allow delete: if isSelf(userId) && isActiveMember();
      }
    }

    // Server-written projection containing only fields safe for member discovery.
    match /publicProfiles/{userId} {
      allow read: if (
        isActiveMember() && isActiveUser(userId)
      ) || isSelf(userId);
      allow write: if false;
    }

    // Phone number and notification delivery data never belong in a public profile.
    match /privateUsers/{userId} {
      allow read: if isSelf(userId) || isAdmin();
      allow create, update: if false;
      allow delete: if false;
    }

    match /dogs/{dogId} {
      allow read: if (
        isActiveMember() && isActiveUser(resource.data.ownerId)
      ) || (signedIn() && resource.data.ownerId == request.auth.uid)
        || isAdmin();
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if (
        signedIn()
        && resource.data.ownerId == request.auth.uid
      ) || isAdmin();
    }

    // Legacy direct swaps remain participant-private.
    match /swapRequests/{swapId} {
      function isSwapParticipant() {
        return isActiveMember() && (
          resource.data.requesterId == request.auth.uid
          || resource.data.receiverId == request.auth.uid
        );
      }

      allow read: if isSwapParticipant() || isAdmin();
      allow create, update: if false;
      allow delete: if false;
    }

    // Block IDs are deterministic: "{blockerId}_{blockedId}". This lets rules
    // enforce a block during message writes without collection queries.
    match /blocks/{blockId} {
      allow read: if isActiveMember() && (
        resource.data.blockerId == request.auth.uid
        || resource.data.blockedId == request.auth.uid
        || isAdmin()
      );
      allow create: if isActiveMember()
        && request.resource.data.keys().hasOnly([
          'blockerId',
          'blockedId',
          'createdAt'
        ])
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedId is string
        && request.resource.data.blockedId != request.auth.uid
        && blockId == request.auth.uid + '_' + request.resource.data.blockedId;
      allow update: if false;
      allow delete: if isActiveMember()
        && resource.data.blockerId == request.auth.uid;
    }

    match /blockReports/{reportId} {
      allow create: if isActiveMember()
        && request.resource.data.keys().hasOnly([
          'reporterId',
          'reportedUserId',
          'reason',
          'details',
          'createdAt'
        ])
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserId != request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 1
        && request.resource.data.reason.size() <= 120
        && (!request.resource.data.keys().hasAny(['details'])
          || (request.resource.data.details is string
            && request.resource.data.details.size() <= 2000));
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /conversations/{convId} {
      function participants() {
        return resource.data.participantIds;
      }

      function isParticipant() {
        return isActiveMember()
          && participants() is list
          && request.auth.uid in participants();
      }

      allow read: if isParticipant() || isAdmin();
      allow create: if false;
      allow update: if (
        isParticipant()
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participantKey == resource.data.participantKey
        && request.resource.data.swapRequestId == resource.data.swapRequestId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'unreadCounts'
        ])
        && request.resource.data.unreadCounts.diff(resource.data.unreadCounts)
          .affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.unreadCounts[request.auth.uid] == 0
      ) || isAdmin();
      allow delete: if false;

      match /messages/{messageId} {
        function conversation() {
          return get(/databases/$(database)/documents/conversations/$(convId)).data;
        }

        function canUseConversation() {
          return isActiveMember()
            && conversation().participantIds is list
            && request.auth.uid in conversation().participantIds;
        }

        allow read: if canUseConversation() || isAdmin();
        allow create: if false;
        allow update: if false;
        allow delete: if canUseConversation()
          && resource.data.senderId == request.auth.uid;
      }
    }

    // Full care instructions, address, responses, and accepted caregiver remain
    // private to the owner and accepted caregiver.
    match /swapPosts/{postId} {
      function isPoster() {
        return isActiveMember() && resource.data.posterId == request.auth.uid;
      }

      function isCaregiver() {
        return isActiveMember() && resource.data.claimedBy == request.auth.uid;
      }

      function isSafePosterUpdate() {
        return isActiveMember()
          && isPoster()
          && request.resource.data.posterId == resource.data.posterId
          && request.resource.data.createdAt == resource.data.createdAt
          && resource.data.status == 'open'
          && request.resource.data.status == 'open'
          && request.resource.data.compensationType in [
            'points',
            'payment',
            'either'
          ]
          && (
            !request.resource.data.keys().hasAny(['pointsCost'])
            || (
              request.resource.data.pointsCost is number
              && request.resource.data.pointsCost >= 0
              && request.resource.data.pointsCost <= 1000
            )
          )
          && (
            !request.resource.data.keys().hasAny(['pointsOffered'])
            || (
              request.resource.data.pointsOffered is number
              && request.resource.data.pointsOffered >= 0
              && request.resource.data.pointsOffered <= 1000
            )
          )
          && (
            !request.resource.data.keys().hasAny(['paymentAmount'])
            || (
              request.resource.data.paymentAmount is number
              && request.resource.data.paymentAmount >= 0
              && request.resource.data.paymentAmount <= 100000
            )
          )
          && (
            !request.resource.data.keys().hasAny(['totalPayment'])
            || (
              request.resource.data.totalPayment is number
              && request.resource.data.totalPayment >= 0
              && request.resource.data.totalPayment <= 100000
            )
          )
          && (
            !request.resource.data.keys().hasAny(['paymentRate'])
            || request.resource.data.paymentRate in ['per_hour', 'per_day']
          )
          && (
            !request.resource.data.keys().hasAny(['totalUnits'])
            || (
              request.resource.data.totalUnits is number
              && request.resource.data.totalUnits >= 0
              && request.resource.data.totalUnits <= 10000
            )
          )
          && (
            !request.resource.data.keys().hasAny(['pointsDisabled'])
            || request.resource.data.pointsDisabled is bool
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'compensationType',
            'pointsCost',
            'pointsOffered',
            'paymentAmount',
            'paymentRate',
            'totalPayment',
            'totalUnits',
            'pointsDisabled',
            'updatedAt'
          ]);
      }

      allow read: if isPoster() || isCaregiver() || isAdmin();
      allow create: if false;
      allow update: if isSafePosterUpdate() || isAdmin();
      allow delete: if false;
    }

    // Sanitized, server-written discovery projection.
    match /publicSwapPosts/{postId} {
      allow read: if isActiveMember()
        && isActiveUser(resource.data.posterId);
      allow write: if false;
    }

    // Server-maintained response index used by an applicant's Pending tab.
    match /postResponses/{responseId} {
      allow read: if isActiveMember() && (
        resource.data.responderId == request.auth.uid
        || get(/databases/$(database)/documents/swapPosts/$(resource.data.postId)).data.posterId == request.auth.uid
        || isAdmin()
      );
      allow write: if false;
    }

    // Reviews are validated and written by submitReview. Client-side creation is
    // denied so a review must correspond to a completed booking and real party.
    match /reviews/{reviewId} {
      allow read: if isActiveMember();
      allow write: if false;
    }

    match /reviews_backup/{reviewId} {
      allow read, write: if false;
    }

    // Validation and redemption are callable Functions. Raw referral records are
    // visible only to their creator and admins.
    match /referral_codes/{codeId} {
      allow read: if signedIn() && (
        resource.data.createdBy == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    match /referralRewards/{rewardId} {
      allow read, write: if false;
    }

    // Legal records are written only by signMembershipAgreement.
    match /signed-agreements/{docId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow write: if false;
    }

    // Internal operational collections are never client-readable.
    match /phoneSignupTickets/{docId} {
      allow read, write: if false;
    }

    match /phoneVerificationRateLimits/{docId} {
      allow read, write: if false;
    }

    match /reminders/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
