rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin helper — Lior's UID has full read/write access
    function isAdmin() {
      return request.auth != null && request.auth.uid == '5SUwrjPWPzbqf7qTYRS74Uj7CB82';
    }

    // Users: read if authenticated (needed for referral lists), write own doc only
    // Admin can read all user docs and update accountStatus
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
        request.auth.uid == userId
        || isAdmin()
      );
      allow delete: if false;

      // Points history: user can read/create their own entries
      match /pointsHistory/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      // Favorites subcollection: user can read/write their own favorites
      match /favorites/{favoriteId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Dogs: read if authenticated, write if owner or admin
    match /dogs/{dogId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // SwapRequests: read/write if participant
    match /swapRequests/{swapId} {
      allow read: if request.auth != null
        && (resource.data.requesterId == request.auth.uid
            || resource.data.receiverId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.requesterId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.requesterId == request.auth.uid
            || resource.data.receiverId == request.auth.uid);
      allow delete: if false;
    }

    // Conversations: read/write if participant
    // ── Blocks ──
    match /blocks/{blockId} {
      // Anyone signed-in can read blocks (needed for both directions)
      allow read: if request.auth != null;
      // Only the blocker can create (must set blockerId to own UID)
      allow create: if request.auth != null
                    && request.resource.data.blockerId == request.auth.uid;
      // Only the blocker can delete their own block
      allow delete: if request.auth != null
                    && resource.data.blockerId == request.auth.uid;
    }

    match /blockReports/{reportId} {
      // Only authenticated users can create block reports
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid;
      // No read/update/delete — admin-only via console
    }

    match /conversations/{convId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participantIds;
      allow delete: if false;

      // Messages: read/write if conversation participant.
      // Allow senderId == 'swapdog-team' for system welcome messages written
      // by an authenticated participant on behalf of the system account.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && (
            request.resource.data.senderId == request.auth.uid
            || request.resource.data.senderId == 'swapdog-team'
          );
        allow update: if false;
        // Allow sender to delete their own messages (e.g. Remove Request)
        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && resource.data.senderId == request.auth.uid;
      }
    }

    // SwapPosts (public bulletin board): any authenticated user can read open posts.
    // Only the poster can create/update their own posts.
    match /swapPosts/{postId} {
      // Any authenticated user can read open posts (the area feed)
      allow read: if request.auth != null;
      // Only the poster can create a post
      allow create: if request.auth != null
        && request.resource.data.posterId == request.auth.uid;
      // Poster can update their own post; any authenticated user can claim it
      // (set claimedBy + status=claimed) or add themselves to respondedBy
      allow update: if request.auth != null
        && (
          // Poster updating their own post
          resource.data.posterId == request.auth.uid
          // Sitter claiming: only status + claimedBy change, posterId unchanged
          || (
            request.resource.data.posterId == resource.data.posterId
            && request.resource.data.status == 'claimed'
            && request.resource.data.claimedBy == request.auth.uid
          )
          // Any authenticated user can add themselves to respondedBy
          // (posterId and status must remain unchanged)
          || (
            request.resource.data.posterId == resource.data.posterId
            && request.resource.data.status == resource.data.status
          )
        );
      allow delete: if false;
    }

    // Reviews: read if authenticated, create only (immutable)
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reviewerId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Referral codes:
    //   - Any authenticated user can read (to validate a code at sign-up)
    //   - Code creator can create their own code documents
    //   - Code creator can update anything on their code
    //   - Any authenticated user can redeem a code (increment usedCount / usedBy),
    //     but the immutable fields (code, createdBy, isActive, maxUses) must not change
    match /referral_codes/{codeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && (
          // Code creator can update anything (e.g. deactivate)
          resource.data.createdBy == request.auth.uid
          // Any authenticated user can redeem: only usedCount and usedBy may change
          || (
            request.resource.data.code       == resource.data.code
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.isActive  == resource.data.isActive
            && request.resource.data.maxUses   == resource.data.maxUses
          )
        );
      allow delete: if false;
    }
  }
}
