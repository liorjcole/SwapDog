rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin helper — Lior's UID has full read/write access
    function isAdmin() {
      return request.auth != null && request.auth.uid == '5SUwrjPWPzbqf7qTYRS74Uj7CB82';
    }

    // Users
    // ── Reads ──
    //   Any authenticated user can read (the feed renders other users' public
    //   profile data — displayName, photoURL, rating). NOTE: email, location
    //   (exact coords) and pushTokens remain readable to any signed-in account.
    //   Hiding those without breaking the feed needs a public-projection doc
    //   (publicProfiles/{uid}) written by a trigger — a data-model change tracked
    //   as a follow-up (audit #3). Not changed here to avoid breaking reads.
    // ── Writes ──
    //   The owner may only mutate an explicit allow-list of profile fields.
    //   rating, reviewCount, points, isAdmin, vettingScheduledAt and the
    //   subscription/* fields are NOT in the list, so they are server-only
    //   (Cloud Functions / admin) — this defeats client rating/points/aggregate
    //   tampering and admin self-promotion (audit #1, #8, #10).
    match /users/{userId} {
      // Fields the client is allowed to set on its own user doc. Any key not
      // listed here (notably rating / reviewCount / points / isAdmin) is denied,
      // making those server-only.
      function isAllowedUserUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoURL', 'bio', 'instagramHandle',
          'location', 'locationGeohash', 'locationName', 'isOnboarded',
          'pushToken', 'pushTokens',
          'referredBy', 'referralCode', 'referralCodeUsed',
          'conductAgreedAt', 'contractSignedAt', 'contractSignedName',
          'contractVersion', 'accountStatus',
          'hiddenReusePostIds', 'postTemplates',
          'pendingReview', 'pendingReferralReward',
          'updatedAt'
        ]);
      }

      // A suspended / terminated / rejected account may not rewrite its own
      // accountStatus (audit #1: "a banned user un-bans themselves"). Onboarding
      // still transitions pending_approval -> active client-side; moving the full
      // lifecycle server-side is a follow-up (audit #2).
      function statusChangeAllowed() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['accountStatus'])
          || !(resource.data.accountStatus in ['suspended', 'terminated', 'rejected']);
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if isAdmin() || (
        request.auth.uid == userId
        && isAllowedUserUpdate()
        && statusChangeAllowed()
      );
      allow delete: if false;

      // Points history: user can read/create their own entries
      match /pointsHistory/{entryId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update, delete: if false;
      }

      // Favorites subcollection: user can read/write their own favorites
      match /favorites/{favoriteId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Private user data, such as phone numbers, must not live on public
    // users/{uid} docs because member profile docs are readable by all signed-in
    // users. Owners can read/write their own private doc; admin can read.
    match /privateUsers/{userId} {
      function hasOnlyPrivateUserFields() {
        return request.resource.data.keys().hasOnly([
          'phoneNumber',
          'authProvider',
          'createdAt',
          'updatedAt'
        ]);
      }

      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == userId
        && hasOnlyPrivateUserFields();
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'phoneNumber',
          'authProvider',
          'updatedAt'
        ])
        && hasOnlyPrivateUserFields();
      allow delete: if false;
    }

    // Dogs: read if authenticated, write if owner or admin
    match /dogs/{dogId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());
      allow delete: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    // SwapRequests: read/write if participant
    match /swapRequests/{swapId} {
      allow read: if request.auth != null
        && (resource.data.requesterId == request.auth.uid
            || resource.data.receiverId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.requesterId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.requesterId == request.auth.uid
            || resource.data.receiverId == request.auth.uid);
      allow delete: if false;
    }

    // Conversations: read/write if participant
    // ── Blocks ──
    match /blocks/{blockId} {
      // Anyone signed-in can read blocks (needed for both directions)
      allow read: if request.auth != null;
      // Only the blocker can create (must set blockerId to own UID)
      allow create: if request.auth != null
                    && request.resource.data.blockerId == request.auth.uid;
      // Only the blocker can delete their own block
      allow delete: if request.auth != null
                    && resource.data.blockerId == request.auth.uid;
    }

    match /blockReports/{reportId} {
      // Only authenticated users can create block reports
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid;
      // No read/update/delete — admin-only via console
    }

    match /conversations/{convId} {
      allow read: if request.auth != null
        && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participantIds;
      allow update: if request.auth != null
        && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      // Messages: read/write if conversation participant.
      // Allow senderId == 'swapdog-team' for system welcome messages written
      // by an authenticated participant on behalf of the system account.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && (
            request.resource.data.senderId == request.auth.uid
            || request.resource.data.senderId == 'swapdog-team'
          );
        allow update: if false;
        // Allow sender to delete their own messages (e.g. Remove Request)
        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds
          && resource.data.senderId == request.auth.uid;
      }
    }

    // SwapPosts (public bulletin board): any authenticated user can read open posts.
    // Only the poster can create/update their own posts.
    match /swapPosts/{postId} {
      function isPostParticipant() {
        return resource.data.posterId == request.auth.uid
          || resource.data.claimedBy == request.auth.uid;
      }

      function isCompletingClaimedPost() {
        return resource.data.status == 'claimed'
          && request.resource.data.status == 'completed'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updatedAt'
          ])
          && isPostParticipant();
      }

      function isCaregiverReopeningPost() {
        return resource.data.status == 'claimed'
          && resource.data.claimedBy == request.auth.uid
          && request.resource.data.posterId == resource.data.posterId
          && request.resource.data.status == 'open'
          && !('claimedBy' in request.resource.data)
          && request.resource.data.respondedBy == []
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'claimedBy',
            'respondedBy',
            'updatedAt'
          ]);
      }

      // Any authenticated user can read open posts (the area feed)
      allow read: if request.auth != null;
      // Only the poster can create a post
      allow create: if request.auth != null
        && request.resource.data.posterId == request.auth.uid;
      // Poster can update their own post; any authenticated user can claim it
      // (set claimedBy + status=claimed) or add themselves to respondedBy
      allow update: if request.auth != null
        && (
          // Poster updating their own post
          resource.data.posterId == request.auth.uid
          // Owner or accepted caregiver can complete a claimed post. This powers
          // review prompts without allowing client-side aggregate/user rewrites.
          || isCompletingClaimedPost()
          // Accepted caregiver can decline an owner reschedule. This reopens
          // the post and clears stale helper requests without touching content.
          || isCaregiverReopeningPost()
          // Sitter claiming: only status + claimedBy change, posterId unchanged
          || (
            request.resource.data.posterId == resource.data.posterId
            && request.resource.data.status == 'claimed'
            && request.resource.data.claimedBy == request.auth.uid
          )
          // Any authenticated user can add themselves to respondedBy
          // (posterId and status must remain unchanged)
          || (
            request.resource.data.posterId == resource.data.posterId
            && request.resource.data.status == resource.data.status
          )
        );
      allow delete: if false;
    }

    // Reviews: read if authenticated, create-only (immutable).
    // Server-side validation (audit #5): reviewer must be the caller, reviewer
    // and reviewee must differ, and rating must be an integer in [1, 5].
    // Malformed / self / out-of-range reviews are rejected at the rules layer
    // so they can never reach the onReviewCreated aggregation trigger.
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.reviewerId == request.auth.uid
        && request.resource.data.revieweeId is string
        && request.resource.data.revieweeId != request.resource.data.reviewerId
        && request.resource.data.targetType is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      // Reviews are immutable once written
      allow update: if false;
      allow delete: if false;
    }

    // Referral codes:
    //   - Any authenticated user can read (to validate a code at sign-up)
    //   - Code creator can create their own code documents
    //   - Code creator can update anything on their code
    //   - Any authenticated user can redeem a code (increment usedCount / usedBy),
    //     but the immutable fields (code, createdBy, isActive, maxUses) must not change
    match /referral_codes/{codeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if request.auth != null
        && (
          // Code creator can update anything (e.g. deactivate)
          resource.data.createdBy == request.auth.uid
          // Any authenticated user can redeem: only usedCount and usedBy may change
          || (
            request.resource.data.code       == resource.data.code
            && request.resource.data.createdBy == resource.data.createdBy
            && request.resource.data.isActive  == resource.data.isActive
            && request.resource.data.maxUses   == resource.data.maxUses
          )
        );
      allow delete: if false;
    }
  
    // ── Signed Agreements (durable legal records) ──────────────────
    match /signed-agreements/{docId} {
      // Any authenticated user can create (when they sign during onboarding)
      allow create: if request.auth != null;
      // Only admin can read (for legal/compliance)
      allow read: if request.auth != null && isAdmin();
      // Nobody can update or delete — these are immutable legal records
      allow update, delete: if false;
    }
  }
}
