rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function userHasCurrentAccess(userId) {
      return (
        firestore.get(/databases/(default)/documents/users/$(userId)).data.subscriptionStatus == 'active'
        && (
          !firestore.get(/databases/(default)/documents/users/$(userId)).data.keys().hasAny(['subscriptionExpiresAt'])
          || firestore.get(/databases/(default)/documents/users/$(userId)).data.subscriptionExpiresAt > request.time
        )
      ) || (
        firestore.get(/databases/(default)/documents/users/$(userId)).data.keys().hasAny(['freeAccessUntil'])
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.freeAccessUntil > request.time
      );
    }

    function hasCurrentAccess() {
      return userHasCurrentAccess(request.auth.uid);
    }

    function isActiveMember() {
      return isAdmin() || (
        signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.accountStatus == 'active'
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isOnboarded == true
        && hasCurrentAccess()
      );
    }

    function isActiveUser(userId) {
      return firestore.exists(/databases/(default)/documents/users/$(userId))
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.accountStatus == 'active'
        && firestore.get(/databases/(default)/documents/users/$(userId)).data.isOnboarded == true
        && userHasCurrentAccess(userId);
    }

    function isValidImageWrite() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    function ownsDog(dogId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/dogs/$(dogId))
        && firestore.get(/databases/(default)/documents/dogs/$(dogId)).data.ownerId == request.auth.uid;
    }

    function hasActiveDogOwner(dogId) {
      return firestore.exists(/databases/(default)/documents/dogs/$(dogId))
        && isActiveUser(
          firestore.get(/databases/(default)/documents/dogs/$(dogId)).data.ownerId
        );
    }

    match /dogs/{dogId}/{allPaths=**} {
      function ownsDogPath() {
        return dogId.matches('temp_' + request.auth.uid + '_.*') || ownsDog(dogId);
      }

      allow read: if (
        isActiveMember() && hasActiveDogOwner(dogId)
      ) || ownsDogPath();
      allow create, update: if signedIn() && ownsDogPath() && isValidImageWrite();
      allow delete: if signedIn() && ownsDogPath();
    }

    match /chat-images/{conversationId}/{allPaths=**} {
      function isParticipant() {
        return isActiveMember()
          && request.auth.uid in firestore.get(
            /databases/(default)/documents/conversations/$(conversationId)
          ).data.participantIds;
      }

      allow read: if isParticipant() || isAdmin();
      allow create, update: if isParticipant() && isValidImageWrite();
      allow delete: if isParticipant();
    }

    // These URLs are referenced only from the participant-private swapPosts doc.
    // Direct Storage reads and writes remain owner-scoped.
    match /care-photos/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isValidImageWrite();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /service-photos/{userId}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isValidImageWrite();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if (
        isActiveMember() && isActiveUser(userId)
      ) || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && isValidImageWrite();
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
